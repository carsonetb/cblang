class Main (int alpha, string beta) = (
    scope func(string to_ret) -> string = {
        return to_ret;
    },

    scope fibbonacci(int n) -> int = {
        if (n == 0) {
            return 0;
        }
        if (n == 1) {
            return 1;
        }

        print("HI");

        int a = 0;
        int b = 1;
        int i = 2;
        while (i <= n) {
            int c = a + b;
            a = b;
            b = c;
            i = i + 1;
        }

        return b;
    }
) 